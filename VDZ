    else
        SpeedButton.Text = "Chạy Nhanh: TẮT"
        SpeedButton.BackgroundColor3 = Color3.fromRGB(50, 50, 50) -- Trả về màu xám khi tắt
    end
    updateSpeed() -- Cập nhật tốc độ ngay lập tức
end)

