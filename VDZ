-- 6. Logic xử lý ESP (Đảm bảo hoạt động)
local espAllEnabled = false
local espTargetEnabled = false
local connectedPlayers = {}

local function BoxPart(part, color)
    if not part:IsA("BasePart") or part.Name == "HumanoidRootPart" then return end
    if part:FindFirstChild("VDZ_PartESP") then return end
    
    local box = Instance.new("BoxHandleAdornment")
    box.Name = "VDZ_PartESP"
    box.Size = part.Size + Vector3.new(0.05, 0.05, 0.05)
    box.Color3 = color
    box.AlwaysOnTop = true
    box.ZIndex = 5
    box.Transparency = 0.5
    box.Adornee = part
    box.Parent = part
end

local function applyESP(targetPlayer)
    if targetPlayer == player then return end
    local function setupChar(character)
        character:WaitForChild("HumanoidRootPart")
        local function checkAndApply()
            local shouldEsp = false
            if espAllEnabled then
                shouldEsp = true
            elseif espTargetEnabled then
                local typedName = string.lower(NameInput.Text)
                local pName = string.lower(targetPlayer.Name)
                local pDisp = string.lower(targetPlayer.DisplayName)
                if typedName ~= "" and (string.find(pName, typedName) or string.find(pDisp, typedName)) then
                    shouldEsp = true
                end
            end
            
            if shouldEsp then
                for _, part in pairs(character:GetChildren()) do BoxPart(part, Color3.fromRGB(0, 255, 128)) end
            else
                for _, part in pairs(character:GetChildren()) do
                    local box = part:FindFirstChild("VDZ_PartESP")
                    if box then box:Destroy() end
                end
            end
        end

        checkAndApply()
        local refreshLoop
        refreshLoop = game:GetService("RunService").Heartbeat:Connect(function()
            if not character or not character.Parent then refreshLoop:Disconnect() return end
            checkAndApply()
        end)
    end
    if targetPlayer.Character then setupChar(targetPlayer.Character) end
    local conn = targetPlayer.CharacterAdded:Connect(setupChar)
    connectedPlayers[targetPlayer] = conn
end

for _, p in pairs(Players:GetPlayers()) do applyESP(p) end
Players.PlayerAdded:Connect(applyESP)

