-- LOGIC XỬ LÝ NHẢY TRÊN KHÔNG (INFINITE JUMP)
local infJumpEnabled = false
local jumpConnection = nil

-- Hàm xử lý kích hoạt lực nhảy
local function doInfJump()
    if infJumpEnabled then
        local character = player.Character
        if character then
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            if humanoid then
                -- Ép nhân vật đổi trạng thái sang đang nhảy và tạo lực hướng lên
                humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
            end
        end
    end
end

-- Sự kiện khi ấn nút Bật/Tắt
InfJumpButton.MouseButton1Click:Connect(function()
    infJumpEnabled = not infJumpEnabled
    if infJumpEnabled then
        InfJumpButton.Text = "Nhảy Trên Không: BẬT"
        InfJumpButton.BackgroundColor3 = Color3.fromRGB(130, 50, 180) -- Màu tím khi bật cho dễ phân biệt
        
        -- Lắng nghe sự kiện bấm nút Nhảy (Spacebar trên PC / nút Nhảy trên Mobile)
        jumpConnection = game:GetService("UserInputService").JumpRequest:Connect(doInfJump)
    else
        InfJumpButton.Text = "Nhảy Trên Không: TẮT"
        InfJumpButton.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        
        -- Hủy kết nối sự kiện để nhân vật trở lại bình thường
        if jumpConnection then
            jumpConnection:Disconnect()
            jumpConnection = nil
        end
    end
end)

-- 7. Cơ chế Kéo Thả cải tiến (Kéo nút tròn để dịch chuyển cả Menu)
local function makeDraggable(clickObject, followObject)
    local dragging, dragInput, dragStart, startPos
    clickObject.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = followObject.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    clickObject.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            followObject.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

-- Kéo Nút VDZ độc lập
local function makeSingleDraggable(guiObject)
    makeDraggable(guiObject, guiObject)
end
